# ═══════════════════════════════════════════════════════
#  AstroVakta Backend — Environment Variables
#  Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════

# ─── Database ───
# Leave empty for SQLite (local dev). Set to Supabase URL for production.
# Get this from: Supabase → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ─── Auth ───
# Generate a random 64-char string: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-random-64-char-string

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ─── Admin Bootstrap ───
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-this-strong-password
ADMIN_NAME=Admin

# Set to "1" to auto-create admin on startup (recommended for Docker)
AUTO_CREATE_ADMIN=1

# ─── Redis (Celery) ───
REDIS_URL=redis://redis:6379/0
REDIS_BACKEND_URL=redis://redis:6379/1

# ─── CORS ───
# Comma-separated list of allowed origins, or * for all
CORS_ORIGINS=https://astrovakta.com,https://www.astrovakta.com

# ─── Environment ───
NODE_ENV=production