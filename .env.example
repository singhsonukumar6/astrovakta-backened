# ═══════════════════════════════════════════════════════
#  AstroVakta Backend — Environment Variables
#  Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════

# ─── Database ───
# Leave empty for SQLite (local dev). Set to Supabase URL for production.
# Get this from: Supabase → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ─── Auth ───
# Generate a random 64-char string: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-random-64-char-string

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ─── Admin Bootstrap ───
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-this-strong-password
ADMIN_NAME=Admin

# Set to "1" to auto-create admin on startup (recommended for Docker)
AUTO_CREATE_ADMIN=1

# ─── Redis (Celery) ───
REDIS_URL=redis://redis:6379/0
REDIS_BACKEND_URL=redis://redis:6379/1

# ─── CORS ───
# Comma-separated list of allowed origins, or * for all
CORS_ORIGINS=https://astrovakta.com,https://www.astrovakta.com

# ─── Email (Resend) ───
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=AstroVakta <noreply@astrovakta.com>

# ─── Frontend URL (for email links) ───
FRONTEND_URL=https://astrovakta.com

# ─── Dodo Payments ───
# Get from: https://app.dodopayments.com (Dashboard → API Keys)
#   Test keys start with dodo_test_ -> API host is test.dodopayments.com
#   Live keys start with dodo_live_ -> API host is live.dodopayments.com
# (Optionally override the host with DODO_API_BASE, e.g. https://test.dodopayments.com)
DODO_API_KEY=dodo_live_xxxxxxxx
# Dodo-hosted checkout success/cancel redirects (defaults to FRONTEND_URL)
DODO_SUCCESS_URL=https://astrovakta.com/dashboard
DODO_CANCEL_URL=https://astrovakta.com/pricing
# Webhook signing secret for verifying Dodo webhook callbacks (Dodo Dashboard → Webhooks)
DODO_WEBHOOK_SECRET=your-dodo-webhook-secret
# ─── Dodo Products ───
# Create products in Dodo Dashboard (Products → New Product) and paste their product IDs.
# Checkout Sessions are priced per product — one line per plan/currency you sell.
# Currency-specific IDs fall back to the plan-level ID if not set.
DODO_PRODUCT_STARTER_USD=pdt_xxxxxxxx
DODO_PRODUCT_STARTER_INR=pdt_xxxxxxxx
DODO_PRODUCT_PRO_USD=pdt_xxxxxxxx
DODO_PRODUCT_PRO_INR=pdt_xxxxxxxx

# ─── Environment ───
NODE_ENV=production