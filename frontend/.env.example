# ─── Frontend Production Environment ───
# Set these in Vercel dashboard → Settings → Environment Variables
# (not in this file — this is just a reference)

# Backend API URL (your DigitalOcean deployment)
VITE_API_BASE_URL=https://api.yourdomain.com

# Default API key for the Kundali Report page
# Leave empty — users will enter their own key in the app
VITE_API_KEY=

# Google Sign-In (Google Identity Services client id — same as GOOGLE_CLIENT_ID on the backend)
VITE_GOOGLE_CLIENT_ID=

# Firebase Auth (client sign-in; same values as the Firebase web-app config.
# Backend needs FIREBASE_PROJECT_ID set to the same project id)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
